#!/usr/bin/env bash
# Finanças — pre-commit hook.
# Roda run_tests.py antes de cada commit. Aborta se algum teste falhar.
# Pula testes se commit só toca docs/config sem efeito em runtime.

set -e
cd "$(git rev-parse --show-toplevel)"

# Arquivos relevantes pra runtime do app
RELEVANT=$(git diff --cached --name-only | grep -E '\.(html|js|ts|tsx|jsx|css|json|py|sql|svg)$' || true)

if [ -z "$RELEVANT" ]; then
  echo "[pre-commit] Sem alteração em código — pulando testes."
  exit 0
fi

echo "[pre-commit] Rodando suíte de testes..."
if python3 run_tests.py; then
  exit 0
else
  echo ""
  echo "✗ TESTES FALHARAM — commit abortado."
  echo "Para emergência (não recomendado): git commit --no-verify"
  exit 1
fi
